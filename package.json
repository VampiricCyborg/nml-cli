{
  "name": "@madhav_ms/nml-cli",
  "version": "0.2.0",
  "description": "Independently verify claims made by AI coding agents.",
  "repository": {"type": "git", "url": "https://github.com/VampiricCyborg/nml-cli.git"},
  "homepage": "https://github.com/VampiricCyborg/nml-cli#readme",
  "bugs": {"url": "https://github.com/VampiricCyborg/nml-cli/issues"},
  "license": "MIT",
  "keywords": ["ai", "coding-agents", "testing", "verification", "git", "cli"],
  "type": "module",
  "bin": {"nml": "dist/cli.js"},
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "bench": "npm run build && node bench/run.mjs",
    "lint": "eslint src test eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --pool=threads --poolOptions.threads.singleThread"
  },
  "engines": {"node": ">=20"},
  "dependencies": {"commander": "^14.0.0"},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
